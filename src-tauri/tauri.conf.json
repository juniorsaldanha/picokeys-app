{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pico Key Manager",
  "version": "0.1.0",
  "identifier": "io.github.picokeymanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run css && dx bundle --package ui --platform web --release --out-dir dist",
    "frontendDist": "../ui/dist/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pico Key Manager",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Manage Pico FIDO / OpenPGP security keys",
    "license": "GPL-3.0-or-later",
    "linux": {
      "deb": { "files": { "/usr/lib/udev/rules.d/70-pico-key.rules": "linux/70-pico-key.rules" } },
      "rpm": { "files": { "/usr/lib/udev/rules.d/70-pico-key.rules": "linux/70-pico-key.rules" } }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  }
}
